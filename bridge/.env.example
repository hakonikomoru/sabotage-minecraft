# Server
PORT=8787
NODE_ENV=development
BRIDGE_API_KEY=change-me

# Platform flags — both true for YouTube Live Chat MVP
ENABLE_YOUTUBE=false
ENABLE_YOUTUBE_CHAT=false
ENABLE_TWITCH=false

# YouTube OAuth + Live Chat
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_LIVE_VIDEO_ID=

# Twitch (MVP: disabled — EventSub post-MVP)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_USER_ID=
TWITCH_MODERATOR_USER_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=
TWITCH_EVENTSUB_TRANSPORT=websocket
ENABLE_TWITCH_CHAT=false
ENABLE_CHANNEL_POINT_EVENTS=false
ENABLE_CHEER_EVENTS=false
ENABLE_SUBSCRIBE_EVENTS=false
ENABLE_FOLLOW_EVENTS=false

# Safety
ENABLE_SUPER_CHAT_EVENTS=false
ENABLE_MEMBER_EVENTS=false
ENABLE_MEDIUM_EFFECTS=false
ENABLE_STRONG_EFFECTS=false
