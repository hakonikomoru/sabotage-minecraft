# Server
PORT=8787
NODE_ENV=development
BRIDGE_API_KEY=change-me

# Platform flags
ENABLE_YOUTUBE=false
ENABLE_YOUTUBE_CHAT=false
ENABLE_TWITCH=false

# YouTube OAuth + Live Chat
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8787/auth/youtube/callback
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_LIVE_VIDEO_ID=

# YouTube quota tuning (liveChatMessages.list = 5 units per request; default daily quota 10,000)
YOUTUBE_MIN_POLL_INTERVAL_MS=15000
YOUTUBE_QUOTA_BACKOFF_MS=300000
YOUTUBE_POLL_ONLY_WHEN_GAME_RUNNING=true
YOUTUBE_IDLE_CHECK_INTERVAL_MS=30000

# Twitch EventSub (BedrockBox MVP)
ENABLE_TWITCH_CHAT=false
ENABLE_TWITCH_CHAT_DISPLAY=true
# Map Twitch events to box_* commands (set false for legacy fill !commands)
ENABLE_BEDROCK_BOX_TWITCH=true

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8787/auth/twitch/callback

TWITCH_BROADCASTER_LOGIN=
TWITCH_BROADCASTER_USER_ID=
TWITCH_USER_ID=
TWITCH_ACCESS_TOKEN=
TWITCH_REFRESH_TOKEN=

TWITCH_EVENTSUB_WEBSOCKET_URL=wss://eventsub.wss.twitch.tv/ws
TWITCH_EVENTSUB_TRANSPORT=websocket

# BedrockBox Twitch EventSub (re-OAuth via /auth/twitch if scopes are missing)
ENABLE_CHANNEL_POINT_EVENTS=true
ENABLE_CHEER_EVENTS=true
ENABLE_SUBSCRIBE_EVENTS=true
ENABLE_FOLLOW_EVENTS=true

# Safety
ENABLE_SUPER_CHAT_EVENTS=false
ENABLE_MEMBER_EVENTS=false
ENABLE_MEDIUM_EFFECTS=false
ENABLE_STRONG_EFFECTS=false
